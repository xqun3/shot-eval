# Copy to .env only for local tooling. Do not commit .env.

# Required for video judging on Vertex AI.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Optional: service-account credentials instead of ADC login.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional: choose a fixed judge model for reproducible runs.
# EVAL_JUDGE_MODEL=gemini-3.8-flash
# EVAL_THINKING_LEVEL=low

# Optional: use a custom prompts.yaml without modifying the package copy.
# SHOT_EVAL_PROMPTS=/absolute/path/to/prompts.yaml

# Optional: model for the ADK post-evaluation optimization agent.
# SHOT_OPTIMIZER_AGENT_MODEL=gemini-3.8-flash

# Never put API keys, bearer tokens, private keys, or internal endpoints here
# when committing this repository. Use your cloud credential manager or local .env.
